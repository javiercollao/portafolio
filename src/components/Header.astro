---
const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <a class="wordmark" href={base} aria-label="Inicio de Javier">JAVIER</a>
  <p class="site-tagline">Ingeniero de software / Santiago, CL</p>
  <nav class="site-nav" aria-label="Navegación principal">
    <a class:list={{ active: current === 'trabajos' }} href={base}>Trabajos</a>
    <a class:list={{ active: current === 'sobre-mi' }} href={`${base}#sobre-mi`}>Sobre mí</a>
    <a class:list={{ active: current === 'blog' }} href={`${base}blog/`}>Blog</a>
    <a href="mailto:javiercollaoc@gmail.com">Contacto</a>
  </nav>
</header>
