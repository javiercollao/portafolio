---
const { page } = Astro.props;
const base = import.meta.env.BASE_URL;

const withBase = (path?: string) => {
  if (!path) return undefined;
  const normalized = path.replace(/^\/+/, '');
  const baseName = base.replace(/^\/+|\/+$/g, '');
  if (baseName && (normalized === baseName || normalized.startsWith(`${baseName}/`))) {
    return `/${normalized}`;
  }
  return `${base}${normalized}`;
};
---

{page.lastPage > 1 && (
  <nav class="pagination" aria-label="Paginación">
    {page.url.prev ? <a href={withBase(page.url.prev)}>← Anterior</a> : <span aria-hidden="true"></span>}
    <span>Página {page.currentPage} / {page.lastPage}</span>
    {page.url.next ? <a href={withBase(page.url.next)}>Siguiente →</a> : <span aria-hidden="true"></span>}
  </nav>
)}
