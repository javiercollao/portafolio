---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft && data.showInBlog))
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
  return paginate(posts, { pageSize: 4 });
}) satisfies GetStaticPaths;

interface Props { page: Page<CollectionEntry<'blog'>> }
const { page } = Astro.props;
---

<BaseLayout title="Blog — Javier" description="Notas sobre software, datos, inteligencia artificial y producto." current="blog">
  <main id="main">
    <header class="page-heading">
      <h1>Notas de ingeniería</h1>
      <p>Ideas, decisiones técnicas y aprendizajes desde proyectos reales. Sin recetas mágicas; con contexto.</p>
    </header>
    <section class="post-grid blog-grid" aria-label="Publicaciones del blog">
      {page.data.map((post, index) => <PostCard post={post} priority={index === 0} />)}
    </section>
    <Pagination page={page} />
  </main>
</BaseLayout>
