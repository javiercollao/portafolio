---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import WorkGrid from '../../../../components/WorkGrid.astro';
import Pagination from '../../../../components/Pagination.astro';
import { categorySlug, workCategoriesFor } from '../../../../lib/work-categories';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft && data.showInWork))
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  const groups = new Map<string, { label: string; posts: CollectionEntry<'blog'>[] }>();
  for (const post of posts) {
    for (const label of workCategoriesFor(post)) {
      const slug = categorySlug(label);
      if (!slug) continue;
      const group = groups.get(slug) ?? { label, posts: [] };
      group.posts.push(post);
      groups.set(slug, group);
    }
  }

  return [...groups.entries()].flatMap(([category, group]) =>
    paginate(group.posts, {
      pageSize: 5,
      params: { category },
      props: { categoryLabel: group.label }
    })
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  categoryLabel: string;
}

const { page, categoryLabel } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${categoryLabel} — Trabajos — Javier`} description={`Proyectos de ${categoryLabel} seleccionados.`} current="trabajos">
  <main id="main">
    <header class="category-heading">
      <div><span>Trabajos / Categoría</span><h1>{categoryLabel}</h1></div>
      <a href={base}>Ver todos los trabajos →</a>
    </header>
    <WorkGrid posts={page.data} />
    <Pagination page={page} />
  </main>
</BaseLayout>
